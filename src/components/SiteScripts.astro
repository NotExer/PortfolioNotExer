---
import { rotatingRoles, translations } from "../data/site";
---

<script is:inline define:vars={{ translations, rotatingRoles }}>
  (() => {
    const root = document.documentElement;
    let currentLanguage = "es";

    try {
      const storedLanguage = localStorage.getItem("notexer-language");
      if (storedLanguage === "es" || storedLanguage === "en") currentLanguage = storedLanguage;
    } catch {
      currentLanguage = "es";
    }

    window.__notexerTranslations = translations;

    const applyLanguage = (language) => {
      currentLanguage = language;
      const dictionary = translations[language];
      root.lang = language;

      document.querySelectorAll("[data-i18n]").forEach((element) => {
        const key = element.dataset.i18n;
        if (key && dictionary[key] !== undefined) element.textContent = dictionary[key];
      });

      document.querySelectorAll("[data-i18n-html]").forEach((element) => {
        const key = element.dataset.i18nHtml;
        if (key && dictionary[key] !== undefined) element.innerHTML = dictionary[key];
      });

      document.querySelectorAll("[data-i18n-placeholder]").forEach((element) => {
        const key = element.dataset.i18nPlaceholder;
        if (key && dictionary[key] !== undefined) element.setAttribute("placeholder", dictionary[key]);
      });

      document.querySelectorAll("[data-i18n-aria]").forEach((element) => {
        const key = element.dataset.i18nAria;
        if (!key || dictionary[key] === undefined) return;
        const title = element.dataset.projectTitle;
        element.setAttribute("aria-label", title ? `${dictionary[key]}: ${title}` : dictionary[key]);
      });

      document.querySelectorAll("[data-language-label]").forEach((element) => {
        element.textContent = language === "es" ? "EN" : "ES";
      });

      document.querySelectorAll("[data-project-external]").forEach((element) => {
        const title = element.dataset.projectTitle;
        if (title) element.setAttribute("aria-label", `${title}. ${dictionary.project_external}`);
      });

      const typingBase = document.querySelector("[data-typing-base]");
      if (typingBase) typingBase.textContent = dictionary.typing_base;

      try {
        localStorage.setItem("notexer-language", language);
      } catch {}

      document.dispatchEvent(new CustomEvent("notexer:language", { detail: { language } }));
    };

    document.querySelectorAll("[data-language-toggle]").forEach((button) => {
      button.addEventListener("click", () => applyLanguage(currentLanguage === "es" ? "en" : "es"));
    });

    const updateThemeControls = () => {
      const dark = root.dataset.theme === "dark";
      document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
        button.setAttribute("aria-pressed", String(dark));
      });
    };

    document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
      button.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;
        try {
          localStorage.setItem("notexer-theme", nextTheme);
        } catch {}
        updateThemeControls();
      });
    });

    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
    systemTheme.addEventListener("change", (event) => {
      try {
        if (localStorage.getItem("notexer-theme")) return;
      } catch {}
      root.dataset.theme = event.matches ? "dark" : "light";
      updateThemeControls();
    });

    const roleElement = document.querySelector("[data-rotating-role]");
    if (roleElement) {
      let roleIndex = 0;
      window.setInterval(() => {
        roleElement.classList.add("is-changing");
        window.setTimeout(() => {
          roleIndex = (roleIndex + 1) % rotatingRoles.length;
          roleElement.textContent = rotatingRoles[roleIndex];
          roleElement.classList.remove("is-changing");
        }, 140);
      }, 2600);
    }

    const revealElements = [...document.querySelectorAll(".reveal-on-scroll")];
    if (!("IntersectionObserver" in window)) {
      revealElements.forEach((element) => element.classList.add("is-visible"));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: "0px 0px -8%", threshold: 0.08 },
      );
      revealElements.forEach((element) => revealObserver.observe(element));
    }

    const sectionLinks = [...document.querySelectorAll("[data-section-link]")];
    const sections = [...document.querySelectorAll(".section-anchor")];
    const sectionNavigations = [...document.querySelectorAll("[data-section-navigation]")];
    const sectionArrivalTimers = new WeakMap();
    const sectionArrivalFrames = new WeakMap();
    let activeSectionId = "";
    let indicatorResizeFrame = 0;
    let programmaticSectionId = "";
    let scrollAnimationFrame = 0;
    let sectionSyncFrame = 0;
    let previousScrollBehavior = null;

    const disableNativeSmoothScroll = () => {
      if (previousScrollBehavior !== null) return;
      previousScrollBehavior = root.style.scrollBehavior;
      root.style.scrollBehavior = "auto";
    };

    const restoreNativeSmoothScroll = () => {
      if (previousScrollBehavior === null) return;
      root.style.scrollBehavior = previousScrollBehavior;
      previousScrollBehavior = null;
    };

    const updateNavigationIndicators = (id, animate = true) => {
      const updates = [];

      if (!animate) {
        sectionNavigations.forEach((navigation) => navigation.classList.remove("is-indicator-ready"));
      }

      sectionNavigations.forEach((navigation) => {
        const activeLink = [...navigation.querySelectorAll("[data-section-link]")].find(
          (link) => link.getAttribute("href") === `#${id}`,
        );
        const indicator = navigation.querySelector("[data-navigation-indicator]");
        if (!activeLink || !indicator) return;

        const navigationRect = navigation.getBoundingClientRect();
        const linkRect = activeLink.getBoundingClientRect();
        if (!navigationRect.width || !linkRect.width) return;

        updates.push({ navigation, x: linkRect.left - navigationRect.left, width: linkRect.width });
      });

      updates.forEach(({ navigation, x, width }) => {
        navigation.style.setProperty(
          "--navigation-indicator-x",
          `${x}px`,
        );
        navigation.style.setProperty("--navigation-indicator-width", `${width}px`);

        if (!navigation.classList.contains("is-indicator-ready")) {
          window.requestAnimationFrame(() => navigation.classList.add("is-indicator-ready"));
        }
      });
    };

    const playSectionArrival = (section) => {
      const previousTimer = sectionArrivalTimers.get(section);
      if (previousTimer) window.clearTimeout(previousTimer);
      const previousFrame = sectionArrivalFrames.get(section);
      if (previousFrame) window.cancelAnimationFrame(previousFrame);
      section.classList.remove("is-section-arriving");
      const frame = window.requestAnimationFrame(() => {
        section.classList.add("is-section-arriving");
        sectionArrivalFrames.delete(section);
      });
      sectionArrivalFrames.set(section, frame);
      const timer = window.setTimeout(() => {
        section.classList.remove("is-section-arriving");
        sectionArrivalTimers.delete(section);
      }, 780);
      sectionArrivalTimers.set(section, timer);
    };

    const cancelSpringScroll = (syncSection = false) => {
      const interrupted = Boolean(scrollAnimationFrame || programmaticSectionId);
      if (scrollAnimationFrame) window.cancelAnimationFrame(scrollAnimationFrame);
      scrollAnimationFrame = 0;
      programmaticSectionId = "";
      restoreNativeSmoothScroll();

      if (syncSection && interrupted) {
        window.requestAnimationFrame(() => syncActiveSectionFromViewport(true));
      }
    };

    const springScrollTo = (section) => {
      cancelSpringScroll(false);
      disableNativeSmoothScroll();
      programmaticSectionId = section.id;

      const scrollMargin = Number.parseFloat(window.getComputedStyle(section).scrollMarginTop) || 0;
      const startY = window.scrollY;
      const maximumY = document.documentElement.scrollHeight - window.innerHeight;
      const targetY = Math.max(
        0,
        Math.min(maximumY, section.getBoundingClientRect().top + startY - scrollMargin),
      );

      const distance = targetY - startY;
      const duration = Math.min(980, Math.max(560, 420 + Math.sqrt(Math.abs(distance)) * 8));
      const startedAt = performance.now();
      playSectionArrival(section);

      const step = (now) => {
        const elapsed = Math.min(1, (now - startedAt) / duration);
        const smoothProgress =
          elapsed < 0.5
            ? 4 * elapsed ** 3
            : 1 - ((-2 * elapsed + 2) ** 3) / 2;
        window.scrollTo(0, startY + distance * smoothProgress);

        if (elapsed < 1) scrollAnimationFrame = window.requestAnimationFrame(step);
        else {
          scrollAnimationFrame = 0;
          programmaticSectionId = "";
          restoreNativeSmoothScroll();
        }
      };

      scrollAnimationFrame = window.requestAnimationFrame(step);
    };

    const setActiveSection = (id, animate = false) => {
      const sectionChanged = activeSectionId !== id;
      activeSectionId = id;

      sectionLinks.forEach((link) => {
        const active = link.getAttribute("href") === `#${id}`;
        if (active) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });

      if (sectionChanged) updateNavigationIndicators(id, animate);

      return sectionChanged;
    };

    const syncActiveSectionFromViewport = (animate = true) => {
      if (programmaticSectionId) return;

      const headerOffset = 96;
      const closestSection = sections.reduce((closest, section) => {
        const distance = Math.abs(section.getBoundingClientRect().top - headerOffset);
        return !closest || distance < closest.distance ? { section, distance } : closest;
      }, null);

      if (closestSection?.section?.id) {
        setActiveSection(closestSection.section.id, animate);
      }
    };

    const scheduleActiveSectionSync = () => {
      if (programmaticSectionId) return;

      window.cancelAnimationFrame(sectionSyncFrame);
      sectionSyncFrame = window.requestAnimationFrame(() => {
        syncActiveSectionFromViewport(true);
      });
    };

    const interruptSpringScroll = () => cancelSpringScroll(true);
    window.addEventListener("wheel", interruptSpringScroll, { passive: true });
    window.addEventListener("touchstart", interruptSpringScroll, { passive: true });
    window.addEventListener("keydown", interruptSpringScroll);
    window.addEventListener("scroll", scheduleActiveSectionSync, { passive: true });

    sectionLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const targetId = link.getAttribute("href")?.slice(1);
        const targetSection = targetId ? document.getElementById(targetId) : null;
        if (!targetSection) return;

        event.preventDefault();
        setActiveSection(targetId, true);
        springScrollTo(targetSection);

        if (window.location.hash !== `#${targetId}`) {
          window.history.pushState(null, "", `#${targetId}`);
        }
      });
    });

    const scheduleNavigationIndicatorUpdate = () => {
      window.cancelAnimationFrame(indicatorResizeFrame);
      indicatorResizeFrame = window.requestAnimationFrame(() => {
        updateNavigationIndicators(activeSectionId, false);
      });
    };

    window.addEventListener("resize", scheduleNavigationIndicatorUpdate, { passive: true });
    document.addEventListener("notexer:language", scheduleNavigationIndicatorUpdate);
    document.fonts?.ready.then(scheduleNavigationIndicatorUpdate);

    document.querySelectorAll("[data-video-toggle]").forEach((button) => {
      button.addEventListener("click", async () => {
        const media = button.closest("[data-project-media]");
        const video = media?.querySelector("[data-project-video]");
        if (!media || !video) return;

        if (!video.getAttribute("src")) {
          video.src = video.dataset.src;
          media.classList.add("is-loading");
          video.load();
        }

        const showVideo = () => {
          media.classList.remove("is-loading");
          media.classList.add("is-ready");
          button.hidden = true;
        };

        if (video.readyState >= 2) showVideo();
        else video.addEventListener("loadeddata", showVideo, { once: true });

        try {
          await video.play();
        } catch {
          media.classList.remove("is-loading");
          button.hidden = false;
        }
      });
    });

    const form = document.querySelector("[data-contact-form]");
    if (form) {
      const status = form.querySelector("[data-form-status]");
      const submitButton = form.querySelector("[data-submit-button]");
      const fields = [...form.querySelectorAll("input[required], textarea[required]")];

      const setFieldError = (field, message) => {
        const error = document.getElementById(`${field.id}-error`);
        field.setAttribute("aria-invalid", message ? "true" : "false");
        if (error) error.textContent = message;
      };

      const validateField = (field) => {
        const dictionary = translations[currentLanguage];
        let message = "";
        if (field.validity.valueMissing) message = dictionary.contact_required;
        else if (field.validity.typeMismatch) message = dictionary.contact_email_error;
        setFieldError(field, message);
        return !message;
      };

      fields.forEach((field) => {
        field.addEventListener("blur", () => validateField(field));
        field.addEventListener("input", () => {
          if (field.getAttribute("aria-invalid") === "true") validateField(field);
        });
      });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const valid = fields.map(validateField).every(Boolean);
        if (!valid) {
          fields.find((field) => field.getAttribute("aria-invalid") === "true")?.focus();
          return;
        }

        const dictionary = translations[currentLanguage];
        submitButton.disabled = true;
        submitButton.setAttribute("aria-busy", "true");
        status.dataset.state = "pending";
        status.textContent = dictionary.contact_sending;

        try {
          const response = await fetch(form.action, {
            method: "POST",
            body: new FormData(form),
            headers: { Accept: "application/json" },
          });
          if (!response.ok) throw new Error("contact-request-failed");
          form.reset();
          fields.forEach((field) => setFieldError(field, ""));
          status.dataset.state = "success";
          status.textContent = dictionary.contact_success;
        } catch {
          status.dataset.state = "error";
          status.textContent = dictionary.contact_error;
        } finally {
          submitButton.disabled = false;
          submitButton.removeAttribute("aria-busy");
        }
      });

      const contactResult = new URLSearchParams(window.location.search).get("contact");
      if (contactResult === "success" || contactResult === "error") {
        status.dataset.state = contactResult;
        status.textContent =
          contactResult === "success"
            ? translations[currentLanguage].contact_success
            : translations[currentLanguage].contact_error;
      }
    }

    applyLanguage(currentLanguage);
    updateThemeControls();
    setActiveSection(window.location.hash.slice(1) || "Home");
  })();
</script>

<script>
  import { injectSpeedInsights } from "@vercel/speed-insights";

  injectSpeedInsights({ framework: "astro" });
</script>
