---
import { Image } from "astro:assets";
import logo from "../assets/images/Logo.webp";
import { navigation, translations } from "../data/site";
import Icon from "./Icon.astro";

const t = translations.es;
---

<a class="skip-link" href="#main-content" data-i18n="skip_link">{t.skip_link}</a>

<header class="site-header" data-site-header>
  <div class="shell header-inner">
    <a class="brand" href="#Home" aria-label="NotExer">
      <span class="brand-mark" aria-hidden="true">
        <Image src={logo} alt="" width={25} height={25} />
      </span>
      <span>NotExer</span>
    </a>

    <nav
      class="desktop-navigation"
      aria-label={t.navigation_label}
      data-i18n-aria="navigation_label"
      data-section-navigation
    >
      <span class="navigation-indicator" aria-hidden="true" data-navigation-indicator></span>
      {
        navigation.map((item) => (
          <a href={item.href} data-section-link>
            <span data-i18n={item.key}>{t[item.key]}</span>
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button
        class="utility-button"
        type="button"
        data-language-toggle
        data-i18n-aria="language_control"
        aria-label={t.language_control}
      >
        <Icon name="language" size={18} />
        <span data-language-label>EN</span>
      </button>
      <button
        class="icon-button"
        type="button"
        data-theme-toggle
        data-i18n-aria="theme_control"
        aria-label={t.theme_control}
        aria-pressed="false"
      >
        <Icon name="sun" class="theme-icon theme-icon-light" />
        <Icon name="moon" class="theme-icon theme-icon-dark" />
      </button>
    </div>
  </div>
</header>

<nav
  class="mobile-dock"
  aria-label={t.navigation_label}
  data-i18n-aria="navigation_label"
  data-section-navigation
>
  <span class="navigation-indicator" aria-hidden="true" data-navigation-indicator></span>
  {
    navigation.map((item) => (
      <a href={item.href} data-section-link>
        <Icon name={item.icon} size={19} />
        <span data-i18n={item.key}>{t[item.key]}</span>
      </a>
    ))
  }
</nav>
